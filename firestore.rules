rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'wins', 'matchesPlayed', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 50
        && data.wins is int
        && data.wins >= 0
        && data.matchesPlayed is int
        && data.matchesPlayed >= 0
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    function isValidMatch(data) {
      return data.keys().hasAll([
        'id', 'roomCode', 'status', 'hostId', 'hostName',
        'activePlayerIndex', 'turnNumber', 'wind', 'terrainSeed',
        'hostHealth', 'guestHealth', 'createdAt', 'updatedAt'
      ])
      && data.id is string
      && data.roomCode is string
      && data.roomCode.size() == 6
      && data.status in ['WAITING', 'ACTIVE', 'FINISHED']
      && data.hostId is string
      && data.hostName is string
      && data.activePlayerIndex is int
      && (data.activePlayerIndex == 0 || data.activePlayerIndex == 1)
      && data.turnNumber is int
      && data.turnNumber >= 0
      && data.wind is number
      && data.terrainSeed is int
      && data.hostHealth is int
      && data.hostHealth >= 0
      && data.hostHealth <= 100
      && data.guestHealth is int
      && data.guestHealth >= 0
      && data.guestHealth <= 100
      && data.createdAt is timestamp
      && data.createdAt <= request.time
      && data.updatedAt is timestamp
      && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId)
                    && isValidUser(request.resource.data)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.id == matchId
                    && isValidMatch(request.resource.data);
      allow update: if isAuthenticated()
                    && (
                      request.auth.uid == resource.data.hostId
                      || request.auth.uid == resource.data.guestId
                      || (resource.data.status == 'WAITING' && request.resource.data.guestId == request.auth.uid)
                    )
                    && isValidMatch(request.resource.data)
                    && request.resource.data.hostId == resource.data.hostId
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.hostId;
    }
  }
}
